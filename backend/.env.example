# SRI BALAJI BACKEND ENVIRONMENT VARIABLES
PROJECT_NAME="Sri Balaji Snacks API"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production; SQLite supported for local dev)
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/sribalaji_db
# Local SQLite default:
DATABASE_URL="sqlite:///./sribalaji.db"

# Admin Setup (Default initial credentials for setup)
FIRST_SUPERUSER_EMAIL="admin@sribalaji.com"
FIRST_SUPERUSER_PASSWORD="ChangeMeAfterFirstLogin123!"

# Media Storage
UPLOAD_DIR="./uploads"

# CORS Origins (Comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Business Settings Defaults
DEFAULT_WHATSAPP_NUMBER="919876543210"
DEFAULT_CONTACT_PHONE="+91 98765 43210"
DEFAULT_STORE_ADDRESS="Wholesale Market, Main Road, [ENTER COMPLETE ADDRESS]"
DEFAULT_STORE_CITY="[ENTER CITY]"
DEFAULT_STORE_STATE="[ENTER STATE]"
DEFAULT_STORE_PIN="[ENTER PIN CODE]"

